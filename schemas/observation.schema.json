{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://white-camellia.local/schemas/observation.schema.json",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "chapterId",
      "title",
      "description",
      "sourceContentIds",
      "discoverCondition",
      "onDiscoverEvents"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "chapterId": {
        "type": "string"
      },
      "title": {
        "type": "string"
      },
      "description": {
        "type": "string"
      },
      "sourceContentIds": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string"
        }
      },
      "discoverCondition": {
        "$ref": "https://white-camellia.local/schemas/definitions.schema.json#/definitions/condition"
      },
      "onDiscoverEvents": {
        "type": "array",
        "items": {
          "$ref": "https://white-camellia.local/schemas/definitions.schema.json#/definitions/event"
        }
      }
    }
  }
}
