{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://white-camellia.local/schemas/reasoning.schema.json",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "chapterId",
      "type",
      "question",
      "entryCondition",
      "slots",
      "solutions",
      "fallbackFeedback"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "chapterId": {
        "type": "string"
      },
      "type": {
        "const": "evidenceCombination"
      },
      "question": {
        "type": "string"
      },
      "entryCondition": {
        "$ref": "https://white-camellia.local/schemas/definitions.schema.json#/definitions/condition"
      },
      "slots": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "label", "kind"],
          "properties": {
            "id": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "kind": {
              "const": "evidence"
            }
          }
        }
      },
      "solutions": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "requiredEvidenceIds", "feedback", "events"],
          "properties": {
            "id": {
              "type": "string"
            },
            "requiredEvidenceIds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            "feedback": {
              "type": "string"
            },
            "events": {
              "type": "array",
              "items": {
                "$ref": "https://white-camellia.local/schemas/definitions.schema.json#/definitions/event"
              }
            }
          }
        }
      },
      "fallbackFeedback": {
        "type": "string"
      }
    }
  }
}
