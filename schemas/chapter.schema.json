{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://white-camellia.local/schemas/chapter.schema.json",
  "title": "White Camellia Chapter",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "order",
    "title",
    "summary",
    "scenes",
    "journalEntries",
    "result",
    "objectives",
    "entryCondition",
    "completionCondition",
    "initialEvents",
    "contentIds",
    "dialogueIds",
    "reasoningIds"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^chapter-[0-9]{2}$"
    },
    "order": {
      "type": "integer",
      "minimum": 0
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "eyebrow", "description", "contentIds"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "eyebrow": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "contentIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "journalEntries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "category",
          "title",
          "text",
          "revealCondition"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "enum": ["fact", "hypothesis", "question"]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "revealCondition": {
            "$ref": "https://white-camellia.local/schemas/definitions.schema.json#/definitions/condition"
          },
          "retireCondition": {
            "$ref": "https://white-camellia.local/schemas/definitions.schema.json#/definitions/condition"
          }
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eyebrow",
        "title",
        "summary",
        "confirmedFacts",
        "unresolvedQuestions",
        "closingLine",
        "evaluationTiers"
      ],
      "properties": {
        "eyebrow": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "confirmedFacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "unresolvedQuestions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "closingLine": {
          "type": "string",
          "minLength": 1
        },
        "evaluationTiers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "minimumScore",
              "title",
              "description"
            ],
            "properties": {
              "minimumScore": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "completionCondition"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "completionCondition": {
            "$ref": "https://white-camellia.local/schemas/definitions.schema.json#/definitions/condition"
          }
        }
      }
    },
    "entryCondition": {
      "$ref": "https://white-camellia.local/schemas/definitions.schema.json#/definitions/condition"
    },
    "completionCondition": {
      "$ref": "https://white-camellia.local/schemas/definitions.schema.json#/definitions/condition"
    },
    "initialEvents": {
      "type": "array",
      "items": {
        "$ref": "https://white-camellia.local/schemas/definitions.schema.json#/definitions/event"
      }
    },
    "contentIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "dialogueIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "reasoningIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "nextChapterId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
