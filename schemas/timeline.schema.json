{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://white-camellia.local/schemas/timeline.schema.json",
  "title": "White Camellia Timeline Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["events", "puzzles"],
  "properties": {
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "chapterId",
          "title",
          "occurredAt",
          "characterIds",
          "locationId",
          "description",
          "revealCondition"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "chapterId": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "occurredAt": {
            "type": "string",
            "minLength": 1
          },
          "characterIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "locationId": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "revealCondition": {
            "$ref": "https://white-camellia.local/schemas/definitions.schema.json#/definitions/condition"
          }
        }
      }
    },
    "puzzles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "chapterId",
          "title",
          "eventIds",
          "entryCondition",
          "solutions",
          "incorrectFeedback"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "chapterId": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "eventIds": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "entryCondition": {
            "$ref": "https://white-camellia.local/schemas/definitions.schema.json#/definitions/condition"
          },
          "solutions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "orderedEventIds", "onSolvedEvents"],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "orderedEventIds": {
                  "type": "array",
                  "minItems": 2,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "onSolvedEvents": {
                  "type": "array",
                  "items": {
                    "$ref": "https://white-camellia.local/schemas/definitions.schema.json#/definitions/event"
                  }
                }
              }
            }
          },
          "incorrectFeedback": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
