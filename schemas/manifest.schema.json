{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://white-camellia.local/schemas/manifest.schema.json",
  "title": "White Camellia Story Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "gameId",
    "schemaVersion",
    "contentVersion",
    "title",
    "startChapterId",
    "chapterIds",
    "dataFiles"
  ],
  "properties": {
    "gameId": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "contentVersion": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "subtitle": {
      "type": "string"
    },
    "startChapterId": {
      "type": "string",
      "minLength": 1
    },
    "chapterIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "dataFiles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content",
        "observations",
        "evidence",
        "dialogues",
        "reasoning"
      ],
      "properties": {
        "content": {
          "$ref": "#/definitions/fileList"
        },
        "observations": {
          "$ref": "#/definitions/fileList"
        },
        "evidence": {
          "$ref": "#/definitions/fileList"
        },
        "dialogues": {
          "$ref": "#/definitions/fileList"
        },
        "reasoning": {
          "$ref": "#/definitions/fileList"
        }
      }
    }
  },
  "definitions": {
    "fileList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
