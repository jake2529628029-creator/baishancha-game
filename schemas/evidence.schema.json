{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://white-camellia.local/schemas/evidence.schema.json",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "chapterId",
      "title",
      "category",
      "description",
      "sourceContentIds",
      "observationIds",
      "collectCondition"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "chapterId": {
        "type": "string"
      },
      "title": {
        "type": "string"
      },
      "category": {
        "enum": ["physical", "medical", "document", "testimony"]
      },
      "description": {
        "type": "string"
      },
      "sourceContentIds": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string"
        }
      },
      "observationIds": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string"
        }
      },
      "collectCondition": {
        "$ref": "https://white-camellia.local/schemas/definitions.schema.json#/definitions/condition"
      }
    }
  }
}
