    "openingLines": [
      {
        "speakerId": "shen-yishu",
        "text": "我申请的不是一个答案。我申请的是先看到原始资料。"
      }
    ],
    "evidenceResponses": [
      {
        "id": "response-ch02-yishu-adult-request",
        "acceptedEvidenceIds": [
          "evidence-ch02-adult-restoration-request"
        ],
        "lines": [
          {
            "speakerId": "shen-yishu",
            "text": "对。我要先知道发生过什么，再由我决定今后怎么使用自己的身份。"
          },
          {
            "speakerId": "shen-yishu",
            "text": "我没有要求你替我选沈小鹿或沈意舒。名字属于我，不是调查者必须替我填上的答案。"
          },
          {
            "speakerId": "shen-yishu",
            "text": "撤回栏不是我填的，我也没有在确认处签名。但在看到更多材料之前，我不会指认是谁撤回了申请。"
          }
        ],
        "events": []
      }
    ],
    "fallbackLines": [
      {
        "speakerId": "shen-yishu",
        "text": "这组材料没有说明我成年后申请了什么。先找到那份由我签字的申请。"
      }
    ],
    "completionEvents": [
      {
        "type": "completeDialogue",
