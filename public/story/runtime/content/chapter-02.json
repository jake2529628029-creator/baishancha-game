    "document": {
      "metadata": {
        "申请人": "沈意舒",
        "提交时间": "案发前三周",
        "申请状态": "已撤回",
        "档案编号": "RS-12-041"
      },
      "paragraphs": [
        {
          "id": "restoration-01",
          "text": "申请书末页留有沈意舒的亲笔签名，签署日期与提交登记一致。"
        },
        {
          "id": "restoration-02",
          "text": "申请事项：调阅本人未成年时期被封存的身份资料，并在知悉全部事实后，自主重新决定身份使用方式。",
          "observationId": "obs-ch02-restoration-purpose"
        },
        {
          "id": "restoration-03",
          "text": "申请理由未提及财产、继承或遗嘱，只写道：“我需要先知道发生过什么，再决定以后使用哪个名字。”"
        },
        {
          "id": "restoration-04",
          "text": "撤回栏由代理经办人填写，理由为“申请人情绪与健康状况不适宜继续办理”；申请人确认签名处为空。",
          "observationId": "obs-ch02-restoration-withdrawn"
        }
      ]
    }
